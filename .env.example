# PurpleIPO — Environment Variables Template
# Copy this to .env.local and fill in your values

# App Authentication
APP_PASSWORD=your_password_here
SESSION_SECRET=your_random_secret_here_min_32_chars

# Supabase PostgreSQL (Transaction Pooler — Port 6543)
DATABASE_URL="postgres://postgres.YOURREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=purpleipo-docs

# Optional: R2 Public Domain (if you configure a public bucket)
# R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
